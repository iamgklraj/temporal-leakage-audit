{
  "description": "Learner sensitivity of the CTO, TrialBench and 20-disease censored-benchmark audits, and temporal-cutoff sensitivity of the CTO audit. All intervals are 95% percentile bootstrap CIs with the clustering unit and resample count of the original analysis.",
  "settings": {
    "learners": {
      "hgb_default": "HistGradientBoostingClassifier(max_depth=3, learning_rate=0.06, max_iter=300, l2_regularization=1.0, random_state=0) -- the paper's learner",
      "logreg_l2": "Pipeline(SimpleImputer(median), StandardScaler(), LogisticRegression(C=1.0, L2 penalty, lbfgs, max_iter=10000))",
      "random_forest": "RandomForestClassifier(n_estimators=500, min_samples_leaf=5, random_state=0, n_jobs=4); missing values handled natively by scikit-learn"
    },
    "bootstrap": {
      "cto": "sponsor-clustered, 1000 resamples, seed 0, paired across tiers",
      "trialbench": "trial-level, 1000 resamples per test set; provided-minus-temporal from independent bootstraps (seeds 0/1)",
      "censored_benchmark_20disease": "target-clustered, 500 resamples, seed 0, paired across horizons"
    },
    "same_bootstrap_resamples_across_learners": true,
    "cto_split_rule": "train = start_year <= int(quantile(start_year, q)); test = later",
    "cto_quantile_note": "start years are integers: q=0.6 and q=0.7 both give 2020 (identical split); q=0.8 (2021) is added as the next distinct later cutoff",
    "threads": {
      "OMP_NUM_THREADS": "4",
      "OPENBLAS_NUM_THREADS": "4"
    },
    "versions": {
      "python": "3.13.5",
      "numpy": "2.5.1",
      "pandas": "3.0.3",
      "scikit-learn": "1.9.0"
    }
  },
  "reproduction_check": {
    "cto": {
      "reference": "outputs/cto_audit.json",
      "compared_fields": [
        "n",
        "n_train",
        "n_test",
        "train_start_year_le",
        "test_base_rate",
        "n_sponsors",
        "tiers",
        "LAP_auprc",
        "LAP_auprc_ci",
        "LAP_p_gt_0",
        "leakage_fraction_of_auprc",
        "LAP_components"
      ],
      "n_leaf_values_compared": 32,
      "exact_match": true,
      "mismatches": []
    },
    "trialbench": {
      "reference": "outputs/trialbench_audit.json",
      "compared_fields": [
        "phases",
        "mean_provided_minus_temporal_auprc",
        "mean_provided_minus_temporal_auroc",
        "mean_provided_minus_temporal_auprc_lift"
      ],
      "n_leaf_values_compared": 117,
      "exact_match": true,
      "mismatches": []
    },
    "censored_benchmark_20disease": {
